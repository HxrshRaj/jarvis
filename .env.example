# Copy to backend/.env (backend) and frontend/.env.local (frontend). Placeholders only — never commit real values.

# --- backend (prefix JARVIS_) ---
JARVIS_SECRET_KEY=change-me-to-a-long-random-string
# Default is a local SQLite file. For Postgres: postgresql+psycopg://user:pass@host:5432/jarvis
# JARVIS_DATABASE_URL=
JARVIS_WORKSPACE_ROOT=./workspace
JARVIS_CORS_ORIGINS=["http://localhost:3000"]

# "mock" = offline mode (no AI answers). "openai_compat" = any OpenAI-compatible /chat/completions API.
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=gpt-4o-mini

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
