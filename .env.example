# Copy to .env (docker compose) and/or backend/.env (local backend) and frontend/.env.local (frontend).
# Placeholders only. Never commit real values.

# --- docker compose (REQUIRED) ---
POSTGRES_PASSWORD=
JARVIS_SECRET_KEY=

# --- backend (prefix JARVIS_) ---
# JARVIS_SECRET_KEY signs session tokens: use a long random string everywhere except throwaway local dev.
# Default database is a local SQLite file. For Postgres: postgresql+psycopg://user:pass@host:5432/jarvis
# JARVIS_DATABASE_URL=
JARVIS_WORKSPACE_ROOT=./workspace
JARVIS_CORS_ORIGINS=["http://localhost:3000"]

# "mock" = offline mode (no AI answers). "openai_compat" = any OpenAI-compatible API (see docs/PROVIDERS.md).
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=
# Optional capabilities (empty = disabled)
JARVIS_LLM_VISION_MODEL=
JARVIS_LLM_STT_MODEL=
JARVIS_LLM_TTS_MODEL=
# Optional cost estimates, USD per 1M tokens (0 = no estimate shown)
JARVIS_PRICE_PROMPT_PER_MTOK=0
JARVIS_PRICE_COMPLETION_PER_MTOK=0
# Router: "rules" (default) or "model" (trained classifier with rules fallback)
JARVIS_ROUTER=rules

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
